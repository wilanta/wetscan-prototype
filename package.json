{
  "name": "wetscan-prototype",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "sentinel:db": "node --env-file-if-exists=.env.sentinel.local --import tsx scripts/sentinel-db.ts",
    "sentinel:worker": "node --env-file-if-exists=.env.sentinel.local --max-old-space-size=256 --import tsx worker/sentinel/main.ts",
    "sentinel:worker:smoke": "node --env-file-if-exists=.env.sentinel.local --import tsx scripts/sentinel-worker-smoke.ts",
    "sentinel:notifier": "node --env-file-if-exists=.env.sentinel.notifier.local --max-old-space-size=192 --import tsx worker/notifier/main.ts",
    "test:sentinel:notifications:postgres": "vitest run -c tests/sentinel/notification-postgres.config.ts",
    "sentinel:health": "node --env-file-if-exists=.env.sentinel.local --import tsx scripts/sentinel-health.ts",
    "test:platform:postgres": "node --env-file-if-exists=.env.sentinel.test.local --import tsx scripts/sentinel-postgres-test.ts",
    "test:sentinel:postgres": "node --env-file-if-exists=.env.sentinel.test.local --import tsx scripts/sentinel-telemetry-test.ts",
    "sentinel:response:fixture": "node --import tsx scripts/sentinel-response-fixture.ts",
    "test:sentinel:response:postgres": "vitest run -c tests/sentinel/response-postgres.config.ts",
    "sentinel:ghost:fixture": "node --env-file-if-exists=.env.sentinel.ghost.local --import tsx scripts/sentinel-ghost-fixture.ts",
    "test:sentinel:ghost:postgres": "vitest run -c tests/sentinel/ghost-postgres.config.ts",
    "test:sentinel:intelligence:postgres": "vitest run -c tests/sentinel/intelligence-postgres.config.ts",
    "test:sentinel:s10:postgres": "vitest run -c tests/sentinel/s10-postgres.config.ts",
    "sentinel:secret-scan": "node --import tsx scripts/sentinel-secret-scan.ts",
    "test:sentinel:s11:postgres": "vitest run -c tests/sentinel/s11-postgres.config.ts",
    "test:sentinel:external:postgres": "vitest run -c tests/sentinel/external-postgres.config.ts",
    "test:sentinel:external:live": "vitest run -c tests/sentinel/external-live.config.ts",
    "sentinel:emit": "node --env-file-if-exists=.env.sentinel.emitter.local --import tsx scripts/sentinel-emit.ts",
    "format": "prettier --write src tests *.ts *.mjs README.md docs/*.md",
    "test:mvp": "node scripts/mvp-check.mjs unit",
    "guard:dev": "next dev --webpack --hostname 127.0.0.1 --port 3000",
    "test:guard:live": "node scripts/guard-live-check.mjs unit"
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.3",
    "@fontsource-variable/geist": "5.3.0",
    "@radix-ui/react-dialog": "1.3.1",
    "@xyflow/react": "12.12.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.72.0",
    "next": "16.4.6",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "type": "module",
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  }
}
