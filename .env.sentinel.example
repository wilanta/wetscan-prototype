# No passwords or connection strings. Copy ONLY to ignored .env.sentinel.local.
# This template does not authorize a database connection or migration.
SENTINEL_DB_HOST=127.0.0.1
SENTINEL_DB_PORT=55432
SENTINEL_DB_NAME=wetscan_dev
# Set a new wetscan-s01:<UUID> marker after reviewing the target database.
SENTINEL_DB_MARKER=
# Absolute paths to ignored local files; actual values are never committed.
SENTINEL_DB_APPROVAL_FILE=
SENTINEL_DB_APP_PASSWORD_FILE=
SENTINEL_DB_WORKER_PASSWORD_FILE=
SENTINEL_DB_MIGRATION_PASSWORD_FILE=
SENTINEL_DB_BOOTSTRAP_PASSWORD_FILE=
# Required reviewed image digest and NEW, explicitly created external volume.
SENTINEL_POSTGRES_IMAGE=
SENTINEL_DB_VOLUME=
SENTINEL_WORKER_CONCURRENCY=2
SENTINEL_WORKER_POLL_MS=1000
SENTINEL_JOB_LEASE_MS=30000
SENTINEL_WORKER_HEARTBEAT_MS=10000
SENTINEL_JOB_TIMEOUT_MS=20000
SENTINEL_WORKER_HEALTH_PORT=3112
SENTINEL_PLATFORM_RETENTION_DAYS=30
