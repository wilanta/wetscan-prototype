# Copy to an ignored .env.sentinel.emitter.local, only after H02 owned-app approval.
# No sender starts automatically. Both switches must be explicitly enabled.
SENTINEL_EMITTER_ENABLED=0
SENTINEL_EMITTER_OWNED_APP_CONFIRMED=0
SENTINEL_INGEST_ENDPOINT=http://127.0.0.1:3000/api/sentinel/ingest
# Absolute private file path outside this repository and OneDrive; no credential value here.
SENTINEL_INGEST_CREDENTIAL_FILE=
