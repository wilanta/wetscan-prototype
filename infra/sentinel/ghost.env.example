# Copy ONLY to an ignored .env.sentinel.ghost.local after H07 owned-app approval.
# Safe default-disabled state: both switches MUST be explicitly 1 to activate the decoy fixture.
# Never put real tokens or secrets here; reference an absolute file outside the repo via SENTINEL_INGEST_CREDENTIAL_FILE.
SENTINEL_GHOST_ENABLED=0
SENTINEL_GHOST_OWNED_APP_CONFIRMED=0
SENTINEL_GHOST_PORT=0
SENTINEL_GHOST_DECOY_PATH=/__wetscan/ghost-decoy
SENTINEL_GHOST_RESPONSE_STATUS=200
SENTINEL_GHOST_RATE_LIMIT=30
SENTINEL_INGEST_ENDPOINT=http://127.0.0.1:3000/api/sentinel/ingest
SENTINEL_INGEST_CREDENTIAL_FILE=
