# S06 credential-isolated notification sender. Copy ONLY to the ignored file .env.sentinel.notifier.local.
# NAMES ONLY: no secret value belongs in this file or in Git. Secrets go in ignored files referenced by *_FILE.
# This process is the ONLY place TELEGRAM_/RESEND_ variables may exist. The main Sentinel worker deletes them at start.
SENTINEL_NOTIFIER_ENABLED=0
SENTINEL_DB_HOST=127.0.0.1
SENTINEL_DB_PORT=55432
SENTINEL_DB_NAME=
SENTINEL_DB_MARKER=
SENTINEL_DB_APPROVAL_FILE=
# Dedicated password of role wetscan_sentinel_notifier (never reuse another role's password).
SENTINEL_DB_NOTIFIER_PASSWORD_FILE=
SENTINEL_NOTIFIER_HEALTH_PORT=3113
SENTINEL_NOTIFIER_SECRET_TTL_MS=15000
SENTINEL_WORKER_POLL_MS=1000
SENTINEL_JOB_LEASE_MS=30000
SENTINEL_WORKER_HEARTBEAT_MS=10000
SENTINEL_JOB_TIMEOUT_MS=20000
# H04 (Telegram): absolute path of a file containing only the bot token.
TELEGRAM_BOT_TOKEN_FILE=
# H05 (optional email): sending-only key file and a verified sender, e.g. "WetScan <alerts@your-domain>".
RESEND_API_KEY_FILE=
NOTIFICATION_FROM_EMAIL=
# The approval file must contain, for exactly one live project:
# "notifications": {"mode":"live","workspaceId":"...","projectId":"github-<id>","notBefore":"<ISO>","channels":["telegram"],"approvedUse":"owner_controlled_notifications"}
