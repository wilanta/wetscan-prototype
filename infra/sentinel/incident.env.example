# Copy to a NEW ignored .env.sentinel.s04.*.local only after exact-target approval.
# Never copy/reopen closed S01/S02/S03 approval records. No credentials or URLs here.
SENTINEL_DETECTION_ENABLED=0
SENTINEL_INCIDENTS_ENABLED=0
SENTINEL_DB_HOST=127.0.0.1
SENTINEL_DB_PORT=55432
SENTINEL_DB_NAME=
SENTINEL_DB_MARKER=
SENTINEL_DB_APPROVAL_FILE=
SENTINEL_DB_APP_PASSWORD_FILE=
SENTINEL_DB_WORKER_PASSWORD_FILE=
SENTINEL_DB_MIGRATION_PASSWORD_FILE=
# New private runtime approval needs detection:{mode,workspaceId,projectId,notBefore,processNewTelemetry:true}
# and incidents:{mode,workspaceId,projectId,notBefore,createFromNewAlerts:true}.
# New TEST approval also needs s04Acceptance:{fixtureId,baselineSha256,backupFile,backupSha256,operations}.
# See SENTINEL_S04_MIGRATION_REVIEW.md. Never set SENTINEL_S04_ACCEPTANCE_RUN manually.
