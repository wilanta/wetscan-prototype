# S09 External Intelligence (public advisory feeds). Copy to a NEW ignored .env.sentinel.*.local only after the owner decides H08.
# Fail closed: the worker contacts CISA/GitHub/OSV only when this flag is 1 AND the private runtime approval carries
#   externalIntel: { mode: "live", workspaceId, projectId, notBefore, providers: ["cisa_kev","ghsa","osv"], approvedUse: "public_advisory_feeds" }
# No credentials or URLs here. NVD is not implemented; NVD_API_KEY is intentionally unused.
SENTINEL_EXTERNAL_INTEL_ENABLED=0
# Optional tuning (milliseconds). Defaults: 6 h cadence, 40 s per-sync budget.
SENTINEL_FEED_INTERVAL_MS=
SENTINEL_FEED_SYNC_BUDGET_MS=
# Optional absolute path to a file containing a GitHub token to raise the GHSA rate limit (never an inline value).
SENTINEL_FEED_GHSA_TOKEN_FILE=
