# Copy to ignored .env.local. Use real local values; never commit credentials.
APP_URL=http://localhost:3000
AUTH_SECRET=replace-with-a-new-random-value-at-least-32-bytes
# Absolute path OUTSIDE the checkout and public directory. Replace <you>.
AUTH_DATA_DIR=C:/Users/<you>/AppData/Local/WetScan/auth
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Existing auth accepts quoted PEM with literal \n separators.
GITHUB_APP_PRIVATE_KEY=
